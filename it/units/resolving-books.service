[Unit]
Description=Late-resolving series decision-time book recorder (read-only, never places orders)
After=network-online.target
[Service]
Type=simple
TimeoutStartSec=180
WorkingDirectory=/mnt/HC_Volume_107257520/pkarbs
ExecStartPre=/usr/bin/python3 pipeline/forward/resolving_books.py preflight --series-file it/resolving_books_series.txt --out /mnt/HC_Volume_107257520/resolving-books --seconds 60
ExecStart=/usr/bin/python3 pipeline/forward/resolving_books.py record --series-file it/resolving_books_series.txt --out /mnt/HC_Volume_107257520/resolving-books --max-hours 720 --full-series elon-tweets,elon-tweets-48h,trump-truth-social,khamenei-daily-tweets,zelenskyy-tweets,ted-cruz-daily-tweets,nycmayor-tweets,cz-tweets,whitehouse-daily-tweets
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
