[Unit]
Description=Late-resolving series decision-time book recorder (read-only, never places orders)
After=network-online.target
[Service]
Type=simple
WorkingDirectory=/mnt/HC_Volume_107257520/pkarbs
ExecStart=/usr/bin/python3 pipeline/forward/resolving_books.py record --series-file it/resolving_books_series.txt --out /mnt/HC_Volume_107257520/resolving-books --max-hours 720
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
