[Unit]
Description=Polymarket Opens Up or Down own-token book recorder (read-only, no keys)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/HC_Volume_107257520

[Service]
Type=simple
WorkingDirectory=/mnt/HC_Volume_107257520
ExecStartPre=/bin/mkdir -p /mnt/HC_Volume_107257520/ocbooks
ExecStart=/usr/bin/python3 REPO_PATH/weekend-perps/open-contracts-2026-11-19/book_recorder.py --out /mnt/HC_Volume_107257520/ocbooks --interval 10
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
